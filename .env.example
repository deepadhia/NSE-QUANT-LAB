# ==============================================================================
# NSE-Quant-Lab Environment Configuration
# ==============================================================================

# 1. MongoDB Database Connection (Market Data & Paper Trading Persistence)
# ------------------------------------------------------------------------------
# Default local MongoDB instance:
MONGO_URI=mongodb://localhost:27017/
# For cloud deployments (e.g. MongoDB Atlas):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
MONGO_DB=stock_scanner
MONGO_COLLECTION=upstox_daily_ohlcv

# 2. Strategy & Portfolio Runtime Configuration
# ------------------------------------------------------------------------------
# Active strategy ID: 'trend_momentum', 'donchian_breakout', etc.
STRATEGY_ID=trend_momentum
# Strategy execution mode: 'paper' (forward paper trading) or 'real' (live broker)
EXECUTION_MODE=paper
# Initial paper trading portfolio equity in INR
INITIAL_CAPITAL=1000000.0
# Target number of concurrent portfolio slots (12 for Trend Momentum)
PORTFOLIO_SIZE=12
# Rebalance frequency: 'MONTHLY' (last trading day of month) or 'DAILY'
REBALANCE_FREQUENCY=MONTHLY

# 3. Execution Limits & Sizing Buffers (Institutional Friction Controls)
# ------------------------------------------------------------------------------
# Modelled slippage per trade leg (0.0010 = 0.10% per leg)
SLIPPAGE_PCT=0.0010
# Maximum allowed positive open gap before skipping buy entry (+2.0%)
LIMIT_CAP_PCT=0.0200
# Cash reservation buffer to avoid account overdraft (1.8%)
CASH_BUFFER_PCT=0.0180
# Circuit breaker protection: True = defer limit-down exits, reject limit-up buys
ENFORCE_CIRCUITS=true

# 4. Telegram Alerts Integration (Signal Alerts & Morning Executions)
# ------------------------------------------------------------------------------
# Set to 'true' to enable Telegram broadcasts
TELEGRAM_ENABLED=false
# Bot token generated via Telegram @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRstuvwx)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Target channel or user chat ID (e.g. -100123456789 or 987654321)
TELEGRAM_CHAT_ID=your_numeric_chat_id_from_userinfobot

# 5. Upstox API v2 Credentials (EOD Daily Candle Ingestion at 15:35 IST)
# ------------------------------------------------------------------------------
# NOTE: Backtesting and strategy signal evaluation operate purely on MongoDB.
# Upstox credentials are ONLY required if you run `scripts/ingest_daily_upstox_candles.py`
# to fetch today's closing market candles automatically at 15:35 IST.
UPSTOX_API_BASE=https://api.upstox.com/v2
UPSTOX_API_KEY=your_upstox_api_key_or_client_id
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=https://127.0.0.1

# Option A: Autonomous Token Refresh (Recommended - No Daily Login / No OTP)
# If UPSTOX_REFRESH_TOKEN is set, scripts/ingest_daily_upstox_candles.py automatically
# calls the token refresh endpoint on every daily run to renew the access token.
UPSTOX_REFRESH_TOKEN=your_upstox_refresh_token_here

# Option B: Manual Daily Access Token or Permanent Analytics Token
# If you prefer pasting a pre-generated token or use an Upstox developer analytics token:
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# 6. System & Logging Settings
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

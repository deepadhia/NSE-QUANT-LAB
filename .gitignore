# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE files
.idea/
.vscode/
*.swp

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Sensitive data & credentials
.env
*.pem
*.key

# Temporary and OS files
*.log
.DS_Store
Thumbs.db
scratch/

# Ephemeral backtest run outputs
results/backtests/
results/realistic_pit_*/
results/true_pit_*/

# Binary datasets & caches
*.parquet
*.pkl


[Unit]
Description=NSE Quant Lab - Read-only Portfolio Dashboard
After=network.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%APP_DIR%
Environment=PYTHONUNBUFFERED=1
# DASHBOARD_HOST / DASHBOARD_PORT / DASHBOARD_USER / DASHBOARD_PASSWORD are read from .env
EnvironmentFile=-%APP_DIR%/.env
ExecStart=%APP_DIR%/venv/bin/python %APP_DIR%/scripts/run_dashboard.py
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nse-quant-lab-dashboard

[Install]
WantedBy=multi-user.target
